# OneCounter runtime configuration
# Copy this file to .env for local backend/frontend integration.
# IMPORTANT:
# - Keep secret keys ONLY in backend runtime.
# - Frontend should only use public/base URL style values.

# ------------------------------
# Frontend (safe to expose)
# ------------------------------
ONECOUNTER_API_BASE_URL=http://localhost:8787
ONECOUNTER_BUSINESS_ID=business-main
ONECOUNTER_STORE_ID=store-main

# ------------------------------
# Supabase (public frontend + backend)
# ------------------------------
SUPABASE_URL=https://oisuwwdykgpghqcvbesj.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional aliases if you prefer Supabase's latest naming in your backend:
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_JWKS_URL=https://oisuwwdykgpghqcvbesj.supabase.co/auth/v1/.well-known/jwks.json
# Backend-only Supabase secret:
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SECRET_KEY

# Optional only if your backend explicitly verifies JWT with shared secret.
# Prefer JWKS verification where possible.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ------------------------------
# WhatsApp Business Cloud API (backend only)
# ------------------------------
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=YOUR_WHATSAPP_WEBHOOK_VERIFY_TOKEN
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET

# ------------------------------
# Google Sheets Integration (backend only)
# ------------------------------
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_DEFAULT_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
GOOGLE_SHEETS_SYNC_CRON=*/30 * * * *

# ------------------------------
# Security / API behavior (backend only)
# ------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CASHIER_IDLE_TIMEOUT_MINUTES=15
ADMIN_IDLE_TIMEOUT_MINUTES=30
ABSOLUTE_SESSION_TIMEOUT_HOURS=10
API_RATE_LIMIT_PER_MINUTE=120
